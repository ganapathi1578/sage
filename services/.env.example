# Copy this file to services/.env and replace all example credential values.
SAGE_PLAYGROUND_USERNAME=sage-research
SAGE_PLAYGROUND_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
SAGE_PLAYGROUND_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_python_-c_import_secrets_print_secrets_token_urlsafe_48

# Shared-network web server. Use 0.0.0.0 only when a firewall restricts access.
SAGE_PLAYGROUND_HOST=0.0.0.0
SAGE_PLAYGROUND_PORT=8765
SAGE_PLAYGROUND_COOKIE_SECURE=0

# Use the physical GPU selected by this service's process visibility. With no
# CUDA_VISIBLE_DEVICES override, auto uses cuda:0 if CUDA is available.
# Optional: expose only physical GPU 2 to the service process. Remove/comment to see all GPUs.
# CUDA_VISIBLE_DEVICES=2
SAGE_PLAYGROUND_DEVICE=auto
SAGE_PLAYGROUND_TEXT_DEVICE=cpu

# Absolute path(s); separate multiple roots with ':' on Linux.
SAGE_PLAYGROUND_VIDEO_ROOTS=/data/dharmendra/sage/data/datasets/charades/Charades_v1_480

# Optional path overrides, all relative paths resolve from the Sage repo root.
# SAGE_PLAYGROUND_OUTPUT_ROOT=outputs/experiments
# SAGE_PLAYGROUND_ANALYSIS_ROOT=UniProp/data/analysis
# SAGE_PLAYGROUND_TEXT_STORE_ROOT=data/embeddings/text/all-MiniLM-L6-v2-tokens
# SAGE_PLAYGROUND_VIDEO_STORE=data/embeddings/charades_v1_480/fastvithd_256_1fps.zarr
# SAGE_PLAYGROUND_FASTVITHD_CONFIG=configs/embeddings/fastvithd_charades.yaml

# Upload/runtime limits.
SAGE_PLAYGROUND_MAX_UPLOAD_BYTES=524288000
SAGE_PLAYGROUND_MAX_UPLOAD_DURATION_SECONDS=600
SAGE_PLAYGROUND_MAX_TEXT_LENGTH=2000
SAGE_PLAYGROUND_MAX_OPTIONS=16
SAGE_PLAYGROUND_MAX_VIDEO_FRAMES=32
SAGE_PLAYGROUND_SESSION_MAX_AGE_SECONDS=43200
